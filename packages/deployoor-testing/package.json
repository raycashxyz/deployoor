{
  "name": "@deployoor/testing",
  "version": "0.3.1",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "Test your deployoor deploys against a real in-memory EVM (EDR) exposed as viem clients \u2014 no local node, no RPC unless you fork.",
  "keywords": [
    "ethereum",
    "evm",
    "viem",
    "testing",
    "smart-contracts",
    "deployments",
    "edr"
  ],
  "license": "MIT",
  "author": "Valerio Leo",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "deployoor": ">=0.5.0 <1.0.0",
    "viem": "^2"
  },
  "dependencies": {
    "@nomicfoundation/edr": "0.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deployoor/evm": "workspace:*",
    "@types/node": "catalog:",
    "deployoor": "workspace:*",
    "tsdown": "^0.22.3",
    "typescript": "catalog:",
    "unrun": "^0.3.1",
    "viem": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raycashxyz/deployoor.git",
    "directory": "packages/deployoor-testing"
  },
  "homepage": "https://github.com/raycashxyz/deployoor/tree/main/packages/deployoor-testing#readme",
  "bugs": {
    "url": "https://github.com/raycashxyz/deployoor/issues"
  }
}
