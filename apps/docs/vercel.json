{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter deployoor build && pnpm --filter @deployoor/docs build",
  "outputDirectory": null,
  "redirects": [
    {
      "source": "/guides/migrate-from-hardhat-deploy",
      "destination": "/migrate/hardhat-deploy",
      "permanent": true
    },
    {
      "source": "/agents.md",
      "destination": "/AGENTS.md",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/introduction",
      "permanent": true
    },
    {
      "source": "/reference",
      "destination": "/reference/cli",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/AGENTS.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ]
}
